{
  "name": "@spaxe-dev/zen-mcp",
  "version": "0.3.3",
  "description": "An agent harness for Zen Browser. Native spaces, background research tabs, and in-browser questions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spaxe-dev/zen-mcp.git"
  },
  "homepage": "https://github.com/spaxe-dev/zen-mcp#readme",
  "bugs": {
    "url": "https://github.com/spaxe-dev/zen-mcp/issues"
  },
  "type": "module",
  "bin": {
    "zen-mcp": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && node dist/cli.js",
    "start": "node dist/cli.js serve",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs test/unit",
    "test:zen": "node scripts/run-tests.mjs test/integration --test-concurrency=1",
    "prepack": "npm run build"
  },
  "keywords": [
    "zen-browser",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "browser-automation",
    "spaces",
    "personal-assistant"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^14.0.3",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
